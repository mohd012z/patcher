<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" app:cardCornerRadius="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
        <TextView android:id="@+id/categoryNumber" android:layout_width="38dp" android:layout_height="38dp" android:gravity="center" android:background="@drawable/bg_category_number" android:textColor="@color/msa_primary" android:textStyle="bold"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
            <TextView android:id="@+id/categoryTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/msa_text" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:id="@+id/categoryState" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Not Run" android:textColor="@color/msa_muted" android:textSize="13sp"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/msa_primary" android:textSize="28sp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
