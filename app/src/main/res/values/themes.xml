<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MSAPatcher" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/msa_primary</item>
        <item name="colorPrimaryVariant">@color/msa_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="android:windowBackground">@color/msa_bg</item>
        <item name="android:fontFamily">sans</item>
        <item name="materialCardViewStyle">@style/Widget.MSAPatcher.Card</item>
    </style>
    <style name="Widget.MSAPatcher.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">#1A7A8699</item>
        <item name="cardBackgroundColor">@color/msa_surface</item>
    </style>
</resources>
